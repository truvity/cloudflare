      }
    }
  },
  "pulumi:providers:cloudflare/provider-platform": {
    "apiToken": {
      "Element": {
        "V": "token-platform"
      }
    }
  },
  "random:index/randomBytes:RandomBytes/tunnel-secret-alpha": {
