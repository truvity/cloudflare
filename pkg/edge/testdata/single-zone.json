  "random:index/randomBytes:RandomBytes/tunnel-secret-alpha-partner": {
    "length": 32
  },
  "truvity:cloudflare:Tunnel/alpha": {},
  "truvity:cloudflare:Tunnel/alpha-partner": {},
  "truvity:cloudflare:Zone/example-test": {},
