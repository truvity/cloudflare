{
  "$id": "https://schemas.example/r2broker/v1/credential-minted.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "group": {
      "type": "string",
      "description": "The group whose grant row authorized this mint.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true
    },
    "bucket": {
      "type": "string",
      "description": "The R2 bucket the credential is scoped to.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true
    },
    "prefixes": {
      "type": "array",
      "description": "The prefixes the credential is scoped to; empty means the whole bucket.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "items": {
        "type": "string",
        "x-audit-class": "shared",
        "x-audit-pii": "none"
      }
    },
    "permission": {
      "type": "string",
      "description": "The permission minted.",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true,
      "enum": ["object-read-only", "object-read-write"]
    },
    "ttl_seconds": {
      "type": "integer",
      "description": "How long the credential lives for.",
      "x-audit-class": "shared",
      "x-audit-pii": "none"
    },
    "mint_mode": {
      "type": "string",
      "description": "Which minter actually produced the credential: local signing, or the Cloudflare API (either configured as primary, or the composite minter's fallback).",
      "x-audit-class": "shared",
      "x-audit-pii": "none",
      "x-audit-facet": true,
      "enum": ["local", "api"]
    }
  }
}
