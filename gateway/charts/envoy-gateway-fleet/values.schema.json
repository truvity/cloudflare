{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "envoy-gateway-fleet chart values",
  "description": "Strict everywhere the chart defines the shape; deliberately open only for documented Kubernetes and controller passthroughs.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "labelKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 317,
      "pattern": "^(([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/)?[A-Za-z0-9]([-.A-Za-z0-9_]{0,61}[A-Za-z0-9])?$"
    },
    "labelValue": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[A-Za-z0-9]([-.A-Za-z0-9_]{0,61}[A-Za-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "qualifiedName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 317,
      "pattern": "^(([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/)?[A-Za-z0-9]([-.A-Za-z0-9_]{0,61}[A-Za-z0-9])?$"
    },
    "labelSelectorRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {
        "key": { "$ref": "#/definitions/labelKey" },
        "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
        "values": { "type": "array", "items": { "$ref": "#/definitions/labelValue" } }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["In", "NotIn"] } } },
          "then": { "required": ["values"], "properties": { "values": { "minItems": 1 } } },
          "else": { "properties": { "values": { "maxItems": 0 } } }
        }
      ]
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/labelKey" },
          "additionalProperties": { "$ref": "#/definitions/labelValue" }
        },
        "matchExpressions": { "type": "array", "items": { "$ref": "#/definitions/labelSelectorRequirement" } }
      },
      "anyOf": [
        { "required": ["matchLabels"], "properties": { "matchLabels": { "minProperties": 1 } } },
        { "required": ["matchExpressions"], "properties": { "matchExpressions": { "minItems": 1 } } }
      ]
    },
    "routeKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "group": { "$ref": "#/definitions/dnsSubdomain" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
      }
    },
    "allowedRoutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": { "enum": ["Same", "All", "Selector"] },
            "selector": { "$ref": "#/definitions/labelSelector" }
          },
          "allOf": [
            {
              "if": { "properties": { "from": { "const": "Selector" } } },
              "then": { "required": ["selector"] },
              "else": { "not": { "required": ["selector"] } }
            }
          ]
        },
        "kinds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/routeKind" } }
      }
    },
    "servicePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "targetPort"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 15, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" },
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "appProtocol": { "$ref": "#/definitions/qualifiedName" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1, "maxLength": 15, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" }
          ]
        },
        "nodePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "controllerName": { "type": "string", "minLength": 1 },
    "commonAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "fleets": {
      "type": "object",
      "description": "One entry per fleet; the key is the GatewayClass name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "gatewayClass": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "envoyProxy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "name": { "type": "string" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
              "mergeGateways": { "type": "boolean" },
              "filterOrder": { "type": "array", "items": { "type": "object" } },
              "service": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                  "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
                }
              },
              "replicas": { "type": "integer", "minimum": 0 },
              "podDisruptionBudget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minAvailable": { "type": ["integer", "null"] }
                }
              },
              "pod": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tolerations": { "type": "array", "items": { "type": "object" } },
                  "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
                  "affinity": { "type": "object" },
                  "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
                }
              },
              "extraSpec": { "type": "object", "description": "Deep-merged over the generated EnvoyProxy spec, verbatim." }
            }
          },
          "healthListener": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "name": { "type": "string" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
              "listenerName": { "type": "string", "minLength": 1 },
              "hostname": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": { "enum": ["HTTP", "HTTPS"] },
              "tls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "secretName": { "type": "string" }
                }
              },
              "certificate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                  "issuerRef": { "type": "object" }
                }
              },
              "allowedRoutes": { "$ref": "#/definitions/allowedRoutes" }
            }
          },
          "listeners": {
            "type": "object",
            "description": "Named exact listener registrations attached to the merged fleet.",
            "propertyNames": {
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": ["enabled"],
                    "properties": { "enabled": { "const": false } }
                  },
                  "then": {},
                  "else": { "required": ["hostname"] }
                },
                {
                  "if": {
                    "required": ["hostname"],
                    "properties": { "hostname": { "pattern": "^\\*\\." } }
                  },
                  "then": {
                    "required": ["allowWildcard"],
                    "properties": { "allowWildcard": { "const": true } }
                  }
                }
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                "gatewayName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                "listenerName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                "hostname": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^(\\*\\.)?([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                },
                "allowWildcard": { "type": "boolean" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "protocol": { "enum": ["HTTP", "HTTPS"] },
                "tls": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "secretName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
                  }
                },
                "certificate": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                    "duration": { "type": "string" },
                    "renewBefore": { "type": "string" },
                    "privateKey": { "type": "object" },
                    "usages": { "type": "array", "items": { "type": "string" } },
                    "issuerRef": { "type": "object" }
                  }
                },
                "allowedRoutes": { "$ref": "#/definitions/allowedRoutes" },
                "clientTrafficPolicy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "name": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                    "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                    "tls": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "minVersion": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
                        "maxVersion": { "enum": ["1.0", "1.1", "1.2", "1.3"] }
                      }
                    }
                  }
                },
                "infraHealth": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "routeName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                    "filterName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                    "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                    "path": { "type": "string", "minLength": 1, "pattern": "^/[^?#]*$" },
                    "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
                    "contentType": { "type": "string", "minLength": 1 },
                    "body": { "type": "string", "maxLength": 4096 }
                  }
                }
              }
            }
          },
          "additionalServices": {
            "type": "object",
            "description": "Chart-owned additional exposure Services selecting the fleet Envoy pods; provider settings come entirely from values.",
            "propertyNames": { "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "allOf": [
                {
                  "if": { "required": ["enabled"], "properties": { "enabled": { "const": false } } },
                  "then": {},
                  "else": { "required": ["ports"] }
                }
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
                "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "loadBalancerClass": { "$ref": "#/definitions/qualifiedName" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/servicePort" } },
                "externalTrafficPolicy": { "enum": ["Cluster", "Local"] },
                "internalTrafficPolicy": { "enum": ["Cluster", "Local"] },
                "allocateLoadBalancerNodePorts": { "type": "boolean" },
                "publishNotReadyAddresses": { "type": "boolean" },
                "sessionAffinity": { "enum": ["None", "ClientIP"] },
                "sessionAffinityConfig": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "clientIP": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": { "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 } }
                    }
                  }
                },
                "ipFamilyPolicy": { "enum": ["SingleStack", "PreferDualStack", "RequireDualStack"] },
                "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] }, "maxItems": 2, "uniqueItems": true },
                "externalIPs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "loadBalancerIP": { "type": "string", "minLength": 1 },
                "healthCheckNodePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "trafficDistribution": { "enum": ["PreferClose", "PreferSameZone", "PreferSameNode"] }
              }
            }
          },
          "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "name": { "type": "string" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
              "ingress": { "type": "array", "items": { "type": "object" } },
              "xds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "controllerPodLabels": { "type": "object", "additionalProperties": { "type": "string" } },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              },
              "egress": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    }
  }
}
